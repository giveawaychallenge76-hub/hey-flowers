{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_comment": "cleanUrls is OFF on purpose: it rewrote /templates/<id>/index.html to /templates/<id> (no trailing slash), so the templates' relative asset paths resolved one directory too high and every image 404'd when a template URL was opened directly.",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/templates/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(stickers|thumbnail|birthday-assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
